{{/* One page per mounted markdown file under formal/ except README.md, which is the section
     page (content/_content.gotmpl): today RESULTS.md, generated by tools/formal_results.py.
     Title from the first heading, references turned into links by the rewrite-refs partial. */}}
{{ range resources.Match "src/formal/*.md" }}
  {{ $name := path.BaseName .Name }}
  {{ if ne $name "README" }}
    {{ $raw := .Content }}
    {{ $title := $name }}
    {{ with findRESubmatch `(?m)^# (.+)$` $raw 1 }}{{ $title = index (index . 0) 1 }}{{ end }}
    {{ $body := partial "rewrite-refs.html" (replaceRE `(?m)^# .+\n` "" $raw 1) }}
    {{ $.AddPage (dict
        "path" (lower $name)
        "title" $title
        "weight" 1
        "content" (dict "mediaType" "text/markdown" "value" $body)
    ) }}
  {{ end }}
{{ end }}
