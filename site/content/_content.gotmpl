{{/* The Decisions section page is adr/README.md (the ADR index). A section page cannot be
     created from inside its own section adapter, so it is added here at the root. */}}
{{ with resources.Get "src/adr/README.md" }}
  {{ $raw := .Content }}
  {{ $title := "Decisions" }}
  {{ with findRESubmatch `(?m)^# (.+)$` $raw 1 }}{{ $title = index (index . 0) 1 }}{{ end }}
  {{/* The index links its ADRs relatively (`[0023](0023-reference-adapters.md)`); a section
       page has no file directory for the link hook to resolve against, so make them absolute. */}}
  {{ $body := replaceRE `\]\((\d{4}-[a-z0-9-]+\.md)\)` "](/adr/$1)" (replaceRE `(?m)^# .+\n` "" $raw 1) }}
  {{ $.AddPage (dict
      "kind" "section"
      "path" "adr"
      "title" $title
      "weight" 5
      "content" (dict "mediaType" "text/markdown" "value" (partial "rewrite-refs.html" $body))
  ) }}
{{ end }}
{{/* The Formal model section page is formal/README.md, for the same reason. */}}
{{ with resources.Get "src/formal/README.md" }}
  {{ $raw := .Content }}
  {{ $title := "Formal model" }}
  {{ with findRESubmatch `(?m)^# (.+)$` $raw 1 }}{{ $title = index (index . 0) 1 }}{{ end }}
  {{ $body := replaceRE `(?m)^# .+\n` "" $raw 1 }}
  {{ $.AddPage (dict
      "kind" "section"
      "path" "formal"
      "title" $title
      "weight" 4
      "content" (dict "mediaType" "text/markdown" "value" (partial "rewrite-refs.html" $body))
  ) }}
{{ end }}
{{/* The Tests section page is tests/README.md (the data contract); the adapter READMEs are
     its pages (content/tests/_content.gotmpl). */}}
{{ with resources.Get "src/tests/README.md" }}
  {{ $raw := .Content }}
  {{ $title := "Conformance tests" }}
  {{ with findRESubmatch `(?m)^# (.+)$` $raw 1 }}{{ $title = index (index . 0) 1 }}{{ end }}
  {{ $body := replaceRE `(?m)^# .+\n` "" $raw 1 }}
  {{ $.AddPage (dict
      "kind" "section"
      "path" "tests"
      "title" $title
      "weight" 3
      "content" (dict "mediaType" "text/markdown" "value" (partial "rewrite-refs.html" $body))
  ) }}
{{ end }}
