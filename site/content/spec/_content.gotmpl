{{/* One page per mounted markdown file: title from the first heading, weight from the
     numeric prefix (plus one, so chapter 00 is not weight 0 = unsorted), references turned
     into links by the rewrite-refs partial. The ADR template and README are not pages here
     (README becomes the section page in content/_content.gotmpl). */}}
{{ range resources.Match "src/spec/*.md" }}
  {{ $name := path.BaseName .Name }}
  {{ if and (ne $name "0000-template") (ne $name "README") }}
    {{ $raw := .Content }}
    {{ $title := $name }}
    {{ with findRESubmatch `(?m)^# (.+)$` $raw 1 }}{{ $title = index (index . 0) 1 }}{{ end }}
    {{ $body := partial "rewrite-refs.html" (replaceRE `(?m)^# .+\n` "" $raw 1) }}
    {{ $weight := 999 }}
    {{ with findRE `^\d+` $name 1 }}{{ $weight = add 1 (int (strings.TrimLeft "0" (index . 0) | default "0")) }}{{ end }}
    {{ $.AddPage (dict
        "path" $name
        "title" $title
        "weight" $weight
        "content" (dict "mediaType" "text/markdown" "value" $body)
    ) }}
  {{ end }}
{{ end }}
